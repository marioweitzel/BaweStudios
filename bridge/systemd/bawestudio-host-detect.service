[Unit]
Description=BaweStudio - host-detect (puerto 5010)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/BaweStudiosLinux
Environment=HOST_DETECT_PORT=5010
ExecStart=/usr/bin/node /home/ubuntu/BaweStudiosLinux/bridge/src/host-detect.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
