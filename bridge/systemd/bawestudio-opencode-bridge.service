[Unit]
Description=BaweStudio - OpenCode bridge (puerto 5002)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/BaweStudiosLinux
Environment=OPENCODE_BRIDGE_PORT=5002
ExecStart=/usr/bin/node /home/ubuntu/BaweStudiosLinux/bridge/src/opencode-bridge.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
